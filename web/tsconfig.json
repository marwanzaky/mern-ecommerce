{
	"compilerOptions": {
		"target": "es2016",
		"module": "node16",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"noEmit": true,
		"incremental": true,
		"moduleResolution": "node16",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@ui/*": ["./components/ui/*"],
			"@components/*": ["./components/*"],
			"@hooks/*": ["./hooks/*"],
			"@redux/*": ["./redux/*"],
			"@services/*": ["./redux/services/*"],
			"@utils/*": ["./utils/*"],
			"@data/*": ["./data/*"],
			"@lib/*": ["./lib/*"],
			"@shared/*": ["./_shared/*"],
			"@app/*": ["./app/*"],
			"@shadcn/*": ["./shadcn/*"],
			"@shared/types/*": ["../shared/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/dev/types/**/*.ts",
		"../shared/src/**/*"
	],
	"exclude": ["node_modules"]
}
